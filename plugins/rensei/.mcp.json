{
  "mcpServers": {
    "rensei": {
      "type": "http",
      "url": "${user_config.mcp_url}",
      "headersHelper": "\"${CLAUDE_PLUGIN_ROOT}/bin/rensei-mcp-headers.sh\" \"${CLAUDE_PLUGIN_DATA}/rensei\""
    },
    "rensei-events": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_DATA}/rensei",
      "args": ["claude", "channel", "serve"]
    }
  }
}
