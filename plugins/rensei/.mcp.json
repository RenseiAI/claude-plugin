{
  "mcpServers": {
    "rensei": {
      "type": "http",
      "url": "${RENSEI_MCP_URL:-https://app.rensei.ai/api/cli/mcp}",
      "headersHelper": "${CLAUDE_PLUGIN_ROOT}/bin/rensei-mcp-headers.sh"
    },
    "rensei-events": {
      "type": "stdio",
      "command": "rensei",
      "args": ["channel", "serve"]
    }
  }
}
